# ─── Required ─────────────────────────────────────────────────────────────
# Google Gemini API key (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to control the bot (zero-trust
# gate). Multiple operators get every alert in parallel. The legacy single-ID
# AUTHORIZED_CHAT_ID variable is still honored when this is unset.
AUTHORIZED_CHAT_IDS=
# AUTHORIZED_CHAT_ID=    # legacy fallback, single ID only

# ─── AI Provider ──────────────────────────────────────────────────────────
# "gemini" (default) or "local" for an OpenAI-compatible endpoint (LM Studio, Ollama, etc.)
LLM_PROVIDER=gemini

# Required only when LLM_PROVIDER=local
LLM_BASE_URL=
LLM_MODEL=
LOCAL_LLM_API_KEY=

# ─── Self-Healing ─────────────────────────────────────────────────────────
# Set "true" to let Gopher-Ops auto-restart failed containers (max 3 attempts)
AUTOPILOT_ENABLED=false

# ─── Alerting Thresholds (optional) ───────────────────────────────────────
# Sustained CPU percentage that triggers an alert (default 80.0)
ALERT_CPU_THRESHOLD=80.0

# Consecutive minutes of high CPU before the alert fires (default 5)
ALERT_CPU_DURATION=5

# Minimum minutes between repeat alerts for the same container (default 15)
ALERT_COOLDOWN_MINUTES=15

# Number of metric points retained in memory (default 60, i.e. 1 hour)
METRICS_HISTORY_SIZE=60

# Percentage of disk usage that triggers an alert (default 85.0). Applies
# to every real (non-pseudo) mounted filesystem. Alert is rate-limited by
# ALERT_COOLDOWN_MINUTES like every other alert.
DISK_ALERT_THRESHOLD=85.0

# Container memory usage % that triggers a pre-OOM pressure alert (default 90.0).
# Only fires for containers that have a memory limit set (--memory flag).
MEM_PRESSURE_THRESHOLD=90.0

# ─── RCA / AI Tuning (optional) ───────────────────────────────────────────
# Number of log lines passed to the AI for root-cause analysis (default 200)
RCA_LOG_LINES=200

# Hard timeout (seconds) on every Gemini / local LLM round-trip (default 60)
AI_TIMEOUT_SECONDS=60

# Set "true" to let the AI directly execute destructive tools (Stop/Restart)
# without going through HITL confirmation buttons. Default false (safer).
AI_DESTRUCTIVE_ALLOWED=false

# ─── Audit Log (optional) ─────────────────────────────────────────────────
# Path where structured JSON-line audit events are appended (default audit.log)
AUDIT_LOG_PATH=audit.log

# Rotate audit.log once it exceeds this size in MB (default 10)
AUDIT_LOG_MAX_SIZE_MB=10

# Number of rotated audit files to keep (default 5 → audit.log.1 … audit.log.5)
AUDIT_LOG_MAX_FILES=5

# ─── Throttling & Reliability (optional) ──────────────────────────────────
# Max messages per minute, per chat. Token bucket; protects API quota.
RATE_LIMIT_PER_MINUTE=30

# Bounded backlog for the async Telegram broadcaster (default 256)
TELEGRAM_QUEUE_SIZE=256

# AI retry on transient failures: total attempts and initial backoff (ms).
# Subsequent attempts double the delay (1s, 2s, 4s by default).
AI_RETRY_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=1000

# ─── HTTP Health Endpoint (optional) ──────────────────────────────────────
# Port for the /health JSON endpoint. Leave empty to disable.
HEALTH_PORT=8080

# ─── HTTP Endpoint Probing (optional) ─────────────────────────────────────
# Comma-separated URLs probed each minute; non-2xx/3xx raises an alert
MONITOR_URLS=

# ─── Terraform (optional) ─────────────────────────────────────────────────
# Working directory for `terraform apply` (default ./terraform). The apply
# call is bounded by a 5-minute timeout so it cannot hang the bot.
TERRAFORM_DIR=./terraform
