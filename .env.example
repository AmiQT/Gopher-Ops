# ─── Required ─────────────────────────────────────────────────────────────
# Google Gemini API key (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Numeric Telegram chat ID allowed to control the bot (zero-trust gate)
AUTHORIZED_CHAT_ID=

# ─── AI Provider ──────────────────────────────────────────────────────────
# "gemini" (default) or "local" for an OpenAI-compatible endpoint (LM Studio, Ollama, etc.)
LLM_PROVIDER=gemini

# Required only when LLM_PROVIDER=local
LLM_BASE_URL=
LLM_MODEL=
LOCAL_LLM_API_KEY=

# ─── Self-Healing ─────────────────────────────────────────────────────────
# Set "true" to let Gopher-Ops auto-restart failed containers (max 3 attempts)
AUTOPILOT_ENABLED=false

# ─── Alerting Thresholds (optional) ───────────────────────────────────────
# Sustained CPU percentage that triggers an alert (default 80.0)
ALERT_CPU_THRESHOLD=80.0

# Consecutive minutes of high CPU before the alert fires (default 5)
ALERT_CPU_DURATION=5

# Minimum minutes between repeat alerts for the same container (default 15)
ALERT_COOLDOWN_MINUTES=15

# Number of metric points retained in memory (default 60, i.e. 1 hour)
METRICS_HISTORY_SIZE=60

# ─── RCA / AI Tuning (optional) ───────────────────────────────────────────
# Number of log lines passed to the AI for root-cause analysis (default 200)
RCA_LOG_LINES=200

# Hard timeout (seconds) on every Gemini / local LLM round-trip (default 60)
AI_TIMEOUT_SECONDS=60

# Set "true" to let the AI directly execute destructive tools (Stop/Restart)
# without going through HITL confirmation buttons. Default false (safer).
AI_DESTRUCTIVE_ALLOWED=false

# ─── Audit Log (optional) ─────────────────────────────────────────────────
# Path where structured JSON-line audit events are appended (default audit.log)
AUDIT_LOG_PATH=audit.log

# ─── HTTP Endpoint Probing (optional) ─────────────────────────────────────
# Comma-separated URLs probed each minute; non-2xx/3xx raises an alert
MONITOR_URLS=
